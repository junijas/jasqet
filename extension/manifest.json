{
  "manifest_version": 3,
  "name": "Jasqet Catcher",
  "version": "1.3.6",
  "description": "Sends your browser downloads to the Jasqet app and adds a Download video button to video players, including YouTube.",
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["menu.js", "content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Jasqet" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
